<?xml version="1.0"?>
<robot name="tof_maix_sense_a010">
  <!--
    Dimensoes do sensor:
      X: largura      = 0.025 m
      Y: altura       = 0.030 m
      Z: profundidade = 0.010 m

    O frame "tof" fica no centro geometrico da caixa.
  -->
  <material name="tof_blue">
    <color rgba="0.10 0.35 0.80 1.0"/>
  </material>

  <link name="tof">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.010"/>
      <inertia
        ixx="8.333333e-07" ixy="0" ixz="0"
        iyy="6.041667e-07" iyz="0"
        izz="1.270833e-06"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.030 0.010"/>
      </geometry>
      <material name="tof_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.030 0.010"/>
      </geometry>
    </collision>
  </link>
</robot>
