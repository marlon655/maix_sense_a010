<?xml version="1.0"?>
<sdf version="1.8">
  <world name="tof_test_circuit">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libgz-sim-physics-system.so" name="gz::sim::systems::Physics"/>
    <plugin filename="libgz-sim-user-commands-system.so" name="gz::sim::systems::UserCommands"/>
    <plugin filename="libgz-sim-scene-broadcaster-system.so" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libgz-sim-contact-system.so" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 18</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 18</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.58 0.58 0.58 1</ambient>
            <diffuse>0.58 0.58 0.58 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Circuito pensado para o palmares_bot: corpo ~0.53 x 0.46 m,
         footprint ~0.56 x 0.54 m. O corredor central tem 1.80 m de largura
         para sobrar margem nas laterais enquanto o ToF observa cada alvo. -->

    <model name="left_lane_marker">
      <static>true</static>
      <pose>5.0 0.90 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>10.0 0.03 0.02</size></box></geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_lane_marker">
      <static>true</static>
      <pose>5.0 -0.90 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>10.0 0.03 0.02</size></box></geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tof_low_curb_3cm">
      <static>true</static>
      <pose>1.20 -0.45 0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.50 0.08 0.03</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.50 0.08 0.03</size></box></geometry>
          <material>
            <ambient>0.05 0.20 1.00 1</ambient>
            <diffuse>0.05 0.20 1.00 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tof_cube_10cm">
      <static>true</static>
      <pose>2.35 0.45 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.10 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.10</size></box></geometry>
          <material>
            <ambient>1.00 0.20 0.05 1</ambient>
            <diffuse>1.00 0.20 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tof_box_30cm">
      <static>true</static>
      <pose>3.60 0.00 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.30 0.30 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.30 0.30 0.30</size></box></geometry>
          <material>
            <ambient>0.95 0.75 0.05 1</ambient>
            <diffuse>0.95 0.75 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tof_tall_panel">
      <static>true</static>
      <pose>4.90 -0.45 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 0.60 0.80</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.60 0.80</size></box></geometry>
          <material>
            <ambient>0.00 0.75 0.25 1</ambient>
            <diffuse>0.00 0.75 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tof_wide_panel">
      <static>true</static>
      <pose>6.20 0.45 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 1.00 0.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 1.00 0.50</size></box></geometry>
          <material>
            <ambient>0.70 0.15 0.95 1</ambient>
            <diffuse>0.70 0.15 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tof_ramp_10deg">
      <static>true</static>
      <pose>7.25 -0.30 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://tof_test_obstacles/meshes/ramp_10deg_short.stl</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://tof_test_obstacles/meshes/ramp_10deg_short.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.20 0.90 0.90 1</ambient>
            <diffuse>0.20 0.90 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="end_panel">
      <static>true</static>
      <pose>9.20 0.00 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 1.40 0.70</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 1.40 0.70</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Faixa lateral para futuro detector de rampas. As rampas ficam
         separadas por ~1,6 m para o robo observar uma inclinacao por vez.
         Altura aproximada = comprimento * sin(inclinacao). -->

    <model name="tof_ramp_5deg_low">
      <static>true</static>
      <pose>1.00 3.00 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://tof_test_obstacles/meshes/ramp_5deg_low.stl</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://tof_test_obstacles/meshes/ramp_5deg_low.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.15 0.70 0.95 1</ambient>
            <diffuse>0.15 0.70 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tof_ramp_10deg_mid">
      <static>true</static>
      <pose>2.50 3.00 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://tof_test_obstacles/meshes/ramp_10deg_mid.stl</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://tof_test_obstacles/meshes/ramp_10deg_mid.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.20 0.90 0.90 1</ambient>
            <diffuse>0.20 0.90 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tof_ramp_15deg_high">
      <static>true</static>
      <pose>4.15 3.00 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://tof_test_obstacles/meshes/ramp_15deg_high.stl</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://tof_test_obstacles/meshes/ramp_15deg_high.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.15 0.95 0.45 1</ambient>
            <diffuse>0.15 0.95 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="tof_ramp_20deg_steep">
      <static>true</static>
      <pose>6.10 3.00 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://tof_test_obstacles/meshes/ramp_20deg_steep.stl</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://tof_test_obstacles/meshes/ramp_20deg_steep.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.95 0.45 0.10 1</ambient>
            <diffuse>0.95 0.45 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
